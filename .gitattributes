# Sin esto, un clon en Windows convierte todo a CRLF y el diff contra el mismo
# archivo en Linux sale entero.
* text=auto eol=lf

# Ensure all text files use LF line endings
* text=auto

# Handle binary files
*.jpg binary
*.png binary
*.gif binary
*.pdf binary

# Specific to Composer
/composer.phar binary

# Ensure consistent Git behavior for specific files
*.md text
*.json text
*.yml text